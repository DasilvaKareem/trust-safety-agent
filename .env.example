# Vercel Integration Configuration
VERCEL_CLIENT_ID=your_vercel_integration_client_id
VERCEL_CLIENT_SECRET=your_vercel_integration_client_secret
VERCEL_INTEGRATION_WEBHOOK_SECRET=your_webhook_secret

# Google Gemini API
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key
# Tier 1 runs on every deploy, tier 2 (heavy thinking) only on escalation
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_DEEP_MODEL=gemini-4-argon
# GEMINI_FAST_THINKING_LEVEL=low
# GEMINI_DEEP_THINKING_LEVEL=high
# GEMINI_ESCALATION_THRESHOLD=0.4

# Storage (choose one)
# Upstash Redis
KV_REST_API_URL=your_upstash_redis_rest_url
KV_REST_API_TOKEN=your_upstash_redis_token

# Or use in-memory storage for local dev (no config needed)

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# eve: bearer token the webhook uses to start eve deep-scan sessions (openssl rand -hex 32)
EVE_SCAN_TOKEN=
# Optional: override where the eve service lives (defaults to the production URL)
# EVE_AGENT_ORIGIN=http://127.0.0.1:3000
# EVE_HANDOFF=off  # scan inline instead

# Accounts: Google OAuth web application (separate from the Gemini API key)
# Authorized redirect URI: https://your-app.example/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate a random value with: openssl rand -hex 32
# Required for auth setup and encryption of Vercel access tokens. Keep stable.
AUTH_SECRET=

# External Vercel integration installation slug
VERCEL_INTEGRATION_SLUG=
# Configure the integration's webhook URL in the Vercel Integration Console:
# https://your-app.example/api/webhooks/vercel
# Events: deployment.ready, integration-configuration.removed

# Vercel Cron authentication. Generate with: openssl rand -hex 32
# The hourly cron processes due website scans in batches; each site is checked daily.
CRON_SECRET=
