# Vercel Integration Configuration
VERCEL_CLIENT_ID=your_vercel_integration_client_id
VERCEL_CLIENT_SECRET=your_vercel_integration_client_secret
VERCEL_INTEGRATION_WEBHOOK_SECRET=your_webhook_secret

# Google Gemini API
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key
# Tier 1 runs on every deploy, tier 2 (heavy thinking) only on escalation
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_DEEP_MODEL=gemini-4-argon
# GEMINI_FAST_THINKING_LEVEL=low
# GEMINI_DEEP_THINKING_LEVEL=high
# GEMINI_ESCALATION_THRESHOLD=0.4

# Storage (choose one)
# Upstash Redis
KV_REST_API_URL=your_upstash_redis_rest_url
KV_REST_API_TOKEN=your_upstash_redis_token

# Or use in-memory storage for local dev (no config needed)

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
