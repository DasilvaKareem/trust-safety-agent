# Vercel Integration Configuration
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
# Normally leave blank: integration webhooks use VERCEL_CLIENT_SECRET.
VERCEL_INTEGRATION_WEBHOOK_SECRET=

# Google Gemini API
GOOGLE_GENERATIVE_AI_API_KEY=
# Tier 1 runs on every deploy, tier 2 (heavy thinking) only on escalation
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_DEEP_MODEL=gemini-4-argon
# GEMINI_FAST_THINKING_LEVEL=low
# GEMINI_DEEP_THINKING_LEVEL=high
# GEMINI_ESCALATION_THRESHOLD=0.4

# Neon Postgres (injected by the Vercel Marketplace integration)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Auth (enable Auth when creating the Neon resource)
NEON_AUTH_BASE_URL=
# Generate with: openssl rand -hex 32
NEON_AUTH_COOKIE_SECRET=

# Optional legacy Redis fallback when DATABASE_URL is not set
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# eve channel and administrative /api/rescan bearer (openssl rand -hex 32)
EVE_SCAN_TOKEN=

# Stable encryption key for connected Vercel credentials (openssl rand -hex 32)
AUTH_SECRET=
# Google sign-in is configured in Neon, not with app GOOGLE_CLIENT_* variables.
# For production, set custom Google credentials in Neon Auth's OAuth settings.
# Google callback: {NEON_AUTH_BASE_URL}/callback/google

# External Vercel integration installation slug
VERCEL_INTEGRATION_SLUG=
# Configure the integration's webhook URL in the Vercel Integration Console:
# https://your-app.example/api/webhooks/vercel
# Events: deployment.succeeded; integration-configuration.removed is automatic

# Bearer token for the on-demand GET /api/sites/monitor batch (no cron is deployed).
# Generate with: openssl rand -hex 32
CRON_SECRET=
