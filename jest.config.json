{
  "preset": "ts-jest/presets/default-esm",
  "testEnvironment": "node",
  "extensionsToTreatAsEsm": [
    ".ts"
  ],
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/$1"
  },
  "transform": {
    "^.+\\.tsx?$": [
      "ts-jest",
      {
        "useESM": true
      }
    ]
  },
  "modulePathIgnorePatterns": [
    "<rootDir>/.eve/",
    "<rootDir>/.next/"
  ],
  "testMatch": [
    "**/__tests__/**/*.test.ts"
  ]
}
